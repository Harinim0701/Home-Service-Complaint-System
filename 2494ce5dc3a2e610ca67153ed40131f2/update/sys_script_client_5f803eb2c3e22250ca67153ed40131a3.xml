        <script><![CDATA[function onLoad() {
    // Define statuses where the form should be editable
    var editableStatuses = ["Draft", "Resubmitted", "Under Review"];

    // Get current status value
    var status = g_form.getValue("status");

    // Check if status is in editable list
    var isEditable = editableStatuses.includes(status);

    // Set the edit_flag field based on the status
    g_form.setValue("edit_flag", isEditable);

}]]></script>
