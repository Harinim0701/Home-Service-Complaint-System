        <name>Auto populate using pincode</name>
        <order/>
        <published_ref/>
        <script><![CDATA[function onChange(control, oldValue, newValue, isLoading) {
  if (isLoading || !newValue) return;
 
  var ga = new GlideAjax('x_1777185_home_s_0.PinCodeHelper');
  ga.addParam('sysparm_name', 'getLocationByPin');
  ga.addParam('sysparm_pincode', newValue);
  ga.getXMLAnswer(function(response) {
    var data = JSON.parse(response);
    if (data && !data.error) {
      g_form.setValue('city', data.city);
      g_form.setValue('district', data.district);
      g_form.setValue('state', data.state);
    } else {
      g_form.showFieldMsg('pin_code', 'Invalid or unrecognized PIN Code', 'error');
    }
  });
}
 ]]></script>
