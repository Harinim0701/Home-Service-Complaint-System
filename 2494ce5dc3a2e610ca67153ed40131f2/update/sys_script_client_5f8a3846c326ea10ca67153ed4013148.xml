        <messages/>
        <name>Validate Age</name>
        <order/>
        <script><![CDATA[function onChange(control, oldValue, newValue, isLoading, isTemplate) {
    if (isLoading || newValue === '') {
      return;
    }
	if (!/^\d+$/.test(newValue)) {
        g_form.showFieldMsg('customer_age', 'Please enter numeric digits only.', 'error');
        return;
    }

    if (newValue) {
        newValue = parseInt(newValue, 10);
        if (newValue < 1 || newValue > 99) {
			g_form.showFieldMsg('customer_age','Age must be less than 2 character.','error');
            return false;
        }
    }

    return true;
}]]></script>
