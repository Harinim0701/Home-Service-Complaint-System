        <script><![CDATA[(function executeRule(current) {
  var gr = new GlideRecord('sys_attachment');
  gr.addQuery('table_sys_id', current.sys_id);
  gr.query();

  var invalidFound = false;

  while (gr.next()) {
    var name = gr.file_name.toLowerCase();
    gs.info('Attachment found: ' + name);

    if (!(name.endsWith('.pdf') || name.endsWith('.png') || name.endsWith('.jpeg'))) {
      gs.addErrorMessage('Only PDF, PNG, or JPEG files are allowed. Invalid file: ' + name);
      invalidFound = true;
    }
  }

  if (invalidFound) {
    current.setAbortAction(true);
  }
})(current);

]]></script>
