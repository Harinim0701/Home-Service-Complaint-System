        <name>Validate Date and Time of Service</name>
        <order/>
        <script><![CDATA[function onChange(control, oldValue, newValue, isLoading, isTemplate) {
   if (isLoading || newValue === '') {
      return;
   }
    if (newValue) {
        var selectedDate = new Date(newValue);
        var now = new Date();

        if (selectedDate > now) {
			g_form.showFieldMsg('date_and_time_of_service','Service date cannot be in the future.','error');
            return false;
        }
    }

    return true;
   
}]]></script>
