        <messages/>
        <name>Validate Contact No</name>
        <order/>
        <script><![CDATA[function onSubmit() {
    var phone = g_form.getValue('contact_number');

    if (!phone) {
        g_form.showFieldMsg('contact_number', 'Contact number is required.', 'error');
        return false;
    }

    // Remove all non-digit characters
    var cleaned = phone.replace(/\D/g, '');

    if (cleaned.length !== 10) {
        g_form.showFieldMsg('contact_number', 'Contact number must be exactly 10 digits.', 'error');
        return false;
    }

    return true;
}
]]></script>
